{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/email/send/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/stripe/create-intent/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/stripe/webhook/?$",
			"dest": "_render"
		},
		{
			"src": "^/grupo/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/mesa/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}